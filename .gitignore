# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging output
build/
dist/
*.egg-info/
.eggs/

# PyInstaller generates a .spec beside the script when run ad hoc;
# packaging/jade-helper.spec is source and stays tracked.
*.spec
!packaging/*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.tox/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
